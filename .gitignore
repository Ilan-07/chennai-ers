# Large derived graph tables (~24 MB). Regenerate with:
#   sh scripts/fetch_ghsl.sh && python scripts/build_graph.py   (~17 min)
data/interim/graph_nodes.parquet
data/interim/graph_edges.parquet
data/interim/graph_consolidated.pkl
data/interim/arc_times.parquet

data/processed/
data/tiles/
*.npz

# Console build artefacts — regenerate with scripts/ui/build_console.sh
data/interim/console.html

# Experiment scratch: intermediate degradation reports written per sweep arm.
# The ARM RESULTS (depth.json, wading.json, ...) are kept; these are not.
data/interim/experiments/_degr_*.json

# React console (build step 19). Both are reproducible from ui/src:
#   make ui   ->  npm ci && vite build
ui/node_modules/
ui/dist/
